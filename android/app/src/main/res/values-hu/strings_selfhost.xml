    <string name="sh_fix_setup">Ha elérhető, szerezd meg a tulajdonosi jogot a Profilban.</string>
    <string name="sh_fix_url">Állítsd be a HTTPS-domaint a telepítőben, és irányítsd a 80-as és 443-as portot a szerver gépére.</string>
