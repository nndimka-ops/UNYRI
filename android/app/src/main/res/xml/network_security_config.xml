<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Fallback for build types without their own file (debug, alpha and
         release override it): HTTPS with system CAs only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
