# Local test ingress only. Use the existing MinIO; no container lifecycle.
{
	admin off
	servers {
		protocols h1
		timeouts {
			read_header 5s
			read_body 30s
			write 60s
		}
	}
}
http://127.0.0.1:59001 {
	reverse_proxy 127.0.0.1:59000 {
		transport http {
			response_header_timeout 30s
		}
	}
}
