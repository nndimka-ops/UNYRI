    },
    "About UNYRI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About UNYRI"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О UNYRI"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про UNYRI"
          }
        }
      }
    },
    "Join UNYRI": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединиться к UNYRI"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join UNYRI"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися до UNYRI"
          }
        }
      }
    },
    "Sent when this phone has a connection and UNYRI can run. The system may delay background sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent when this phone has a connection and UNYRI can run. The system may delay background sending."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправится, когда на этом телефоне будет сеть и UNYRI сможет работать. Система может задержать фоновую отправку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде надіслано, коли цей телефон матиме з’єднання з мережею і UNYRI зможе працювати. Система може затримати фонове надсилання."
          }
        }
      }
    },
    "Enable reminders in UNYRI notification settings first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable reminders in UNYRI notification settings first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите напоминания в настройках уведомлений UNYRI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку ввімкніть нагадування в налаштуваннях сповіщень UNYRI."
          }
        }
      }
    },
    "Enable UNYRI notifications in phone settings to receive reminders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable UNYRI notifications in phone settings to receive reminders."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите уведомления UNYRI в настройках телефона для напоминаний."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримувати нагадування, увімкніть сповіщення UNYRI в параметрах телефона."
          }
        }
      }
    },
    "A security key is your device’s digital ID, not a password. It can change after reinstalling UNYRI or changing phones. Never send anyone your passwords or recovery keys.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A security key is your device’s digital ID, not a password. It can change after reinstalling UNYRI or changing phones. Never send anyone your passwords or recovery keys."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ безопасности — цифровое удостоверение устройства, а не пароль. Он может измениться после переустановки UNYRI или смены телефона. Пароли и ключи восстановления никому передавать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ безпеки — цифрове посвідчення пристрою, а не пароль. Він може змінитися після перевстановлення UNYRI або зміни телефона. Паролі та ключі відновлення нікому передавати не потрібно."
          }
        }
      }
    },
    "Days without opening UNYRI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days without opening UNYRI"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дней без открытия UNYRI"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Днів без відкриття UNYRI"
          }
        }
      }
    },
    "Opening UNYRI with a server connection on any device resets the inactivity period. Background notifications and token refresh do not reset it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening UNYRI with a server connection on any device resets the inactivity period. Background notifications and token refresh do not reset it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытие UNYRI с подключением к серверу на любом устройстве начинает отсчёт заново. Фоновые уведомления и обновление токена не сбрасывают срок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриття UNYRI з підключенням до сервера на будь-якому пристрої починає відлік заново. Фонові сповіщення й оновлення токена не скидають строк."
          }
        }
      }
    },
    "If you do not open UNYRI with a server connection on any device for %d days, your account will be permanently deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you do not open UNYRI with a server connection on any device for %d days, your account will be permanently deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в течение %d дней вы не откроете UNYRI с подключением к серверу ни на одном устройстве, ваш аккаунт будет удалён навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо протягом %d днів ви не відкриєте UNYRI з підключенням до сервера на жодному пристрої, ваш акаунт буде видалено назавжди."
          }
        }
      }
    },
    "Deletion removes the account, chats, messages, calls, media and history backups from UNYRI for both sides. There is no recovery. Other devices and your contacts' phones update when they connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion removes the account, chats, messages, calls, media and history backups from UNYRI for both sides. There is no recovery. Other devices and your contacts' phones update when they connect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из UNYRI будут удалены аккаунт, чаты, сообщения, звонки, медиа и резервные копии истории с обеих сторон. Восстановление невозможно. Другие устройства и телефоны собеседников обновятся при подключении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З UNYRI буде видалено акаунт, чати, повідомлення, дзвінки, медіа та резервні копії історії з обох сторін. Відновлення неможливе. Інші пристрої й телефони співрозмовників оновляться після підключення."
          }
        }
      }
    },
    "One static background throughout UNYRI. No animation or extra work while scrolling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One static background throughout UNYRI. No animation or extra work while scrolling."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один статичный фон во всём UNYRI. Без анимации и дополнительной работы при прокрутке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Єдине статичне тло в усьому UNYRI. Без анімації та додаткової роботи під час прокручування."
          }
        }
      }
    },
    "UNYRI default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UNYRI default"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарт UNYRI"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарт UNYRI"
          }
        }
      }
    },
    "Reset preview to UNYRI default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset preview to UNYRI default"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть стандарт UNYRI в примере"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернути стандарт UNYRI в прикладі"
          }
        }
      }
    },
    "Enter the recovery key saved when the backup was created. UNYRI will verify it without importing or changing your messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key saved when the backup was created. UNYRI will verify it without importing or changing your messages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ, сохранённый при создании копии. UNYRI проверит его, не импортируя и не изменяя сообщения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ключ, збережений під час створення копії. UNYRI перевірить його, не імпортуючи й не змінюючи повідомлення."
          }
        }
      }
    },
    "This key is only for history. It is not your account password or a six-digit sign-in code. Keep it outside UNYRI: without it, an encrypted backup cannot be opened. The server never receives this key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key is only for history. It is not your account password or a six-digit sign-in code. Keep it outside UNYRI: without it, an encrypted backup cannot be opened. The server never receives this key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ключ только для истории. Он не заменяет пароль аккаунта и не является шестизначным кодом входа. Сохраните его вне UNYRI: без него зашифрованную копию открыть нельзя. Сервер не получает этот ключ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ключ лише для історії. Він не замінює пароль облікового запису й не є шестизначним кодом входу. Збережіть його поза UNYRI: без нього зашифровану копію відкрити неможливо. Сервер не отримує цей ключ."
          }
        }
      }
    },
    "Save the recovery key outside UNYRI and confirm its last 8 characters. Then continue the transfer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните ключ вне UNYRI и подтвердите его последние 8 символов. Затем продолжите перенос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть ключ відновлення поза UNYRI та підтвердьте його останні 8 символів. Потім продовжте перенесення."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the recovery key outside UNYRI and confirm its last 8 characters. Then continue the transfer."
          }
        }
      }
    },
    "iOS chooses when background copies can run. UNYRI also checks for an overdue daily copy when you open the app. Keep your recovery key saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chooses when background copies can run. UNYRI also checks for an overdue daily copy when you open the app. Keep your recovery key saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS выбирает время фонового копирования. UNYRI также проверяет, нужна ли ежедневная копия, при открытии приложения. Сохраните ключ восстановления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS обирає час фонового копіювання. UNYRI також перевіряє, чи потрібна щоденна копія, коли ви відкриваєте застосунок. Збережіть ключ відновлення."
          }
        }
      }
    },
    "This is not a valid UNYRI history transfer code. Show a new code from Receive on this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid UNYRI history transfer code. Show a new code from Receive on this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не действующий код переноса UNYRI. На новом телефоне откройте «Получить на этот телефон» и покажите новый QR-код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не чинний код перенесення UNYRI. На новому телефоні відкрийте «Отримати на цей телефон» і покажіть новий QR-код."
          }
        }
      }
    },
    "Before sending, prepare the old phone in History and backups and keep its recovery key saved outside UNYRI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sending, prepare the old phone in History and backups and keep its recovery key saved outside UNYRI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед переносом откройте «История и резервные копии» на старом телефоне. Подготовьте историю и сохраните ключ восстановления вне UNYRI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед перенесенням відкрийте «Історія та резервні копії» на старому телефоні. Підготуйте історію та збережіть ключ відновлення поза UNYRI."
          }
        }
      }
    },
    "While UNYRI is open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While UNYRI is open"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда UNYRI открыт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли UNYRI відкрито"
          }
        }
      }
    },
    "Messages and calls can arrive over Wi-Fi if the selected UNYRI server is reachable on that network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages and calls can arrive over Wi-Fi if the selected UNYRI server is reachable on that network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения и звонки могут приходить по Wi-Fi, если выбранный сервер UNYRI доступен в этой сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення й дзвінки можуть надходити через Wi-Fi, якщо вибраний сервер UNYRI доступний у цій мережі."
          }
        }
      }
    },
    "When iPhone is locked or UNYRI is closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When iPhone is locked or UNYRI is closed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда iPhone заблокирован или UNYRI закрыт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли iPhone заблоковано або UNYRI закрито"
          }
        }
      }
    },
    "Enable notifications for UNYRI in iPhone settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications for UNYRI in iPhone settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления для UNYRI в настройках iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте сповіщення для UNYRI в налаштуваннях iPhone."
          }
        }
      }
    },
    "Records timings, frame delays, memory, network state and technical stages while UNYRI is open. No messages, passwords, keys, typed text or screen recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records timings, frame delays, memory, network state and technical stages while UNYRI is open. No messages, passwords, keys, typed text or screen recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока UNYRI открыт, записываются задержки, кадры, память, состояние сети и этапы работы. Без сообщений, паролей, ключей, вводимого текста и записи экрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки UNYRI відкрито, записуються затримки, кадри, пам’ять, стан мережі та етапи роботи. Без повідомлень, паролів, ключів, введеного тексту та запису екрана."
          }
        }
      }
    },
    "Mark the problem, continue using UNYRI briefly, then send a report. A small window before and after the mark is preserved. Collection pauses in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the problem, continue using UNYRI briefly, then send a report. A small window before and after the mark is preserved. Collection pauses in the background."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте проблему, немного продолжите пользоваться UNYRI и отправьте отчёт. Небольшой набор событий до и после отметки сохраняется отдельно. В фоне запись приостанавливается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте проблему, трохи продовжте користуватися UNYRI й надішліть звіт. Невеликий набір подій до та після позначки зберігається окремо. У фоні запис призупиняється."
          }
        }
      }
    },
    "Use Face ID, Touch ID or your iPhone system passcode. UNYRI does not store a separate PIN. Calls and rooms continue while locked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID, Touch ID or your iPhone system passcode. UNYRI does not store a separate PIN. Calls and rooms continue while locked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID, Touch ID или системный код iPhone. Отдельного PIN в UNYRI нет. Звонки и комнаты продолжают работать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID, Touch ID або системний код iPhone. Окремого PIN у UNYRI немає. Дзвінки та кімнати продовжують працювати."
          }
        }
      }
    },
    "Before signing out, finish an encrypted backup and save its history recovery key outside UNYRI. You will need both to restore your history. Or transfer it from another phone where you are still signed in and your history is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before signing out, finish an encrypted backup and save its history recovery key outside UNYRI. You will need both to restore your history. Or transfer it from another phone where you are still signed in and your history is available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед выходом завершите зашифрованное копирование и сохраните ключ восстановления истории вне UNYRI. Для восстановления понадобятся и копия, и ключ. Другой способ — перенести историю с телефона, где вы ещё вошли в аккаунт и история сохранилась."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед виходом завершіть зашифроване копіювання та збережіть ключ відновлення історії поза UNYRI. Для відновлення потрібні і копія, і ключ. Інший спосіб — перенести історію з телефона, де ви ще ввійшли в акаунт і історія збереглася."
          }
        }
      }
    },
    "Deleting your account is permanent. Your profile, messages, files and direct chats will be removed from the server. Direct chats will also disappear from your contacts' UNYRI apps when they synchronize. Copies already saved outside UNYRI cannot be removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account is permanent. Your profile, messages, files and direct chats will be removed from the server. Direct chats will also disappear from your contacts' UNYRI apps when they synchronize. Copies already saved outside UNYRI cannot be removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление аккаунта необратимо. Ваш профиль, сообщения, файлы и личные чаты будут удалены с сервера. После синхронизации личные чаты также исчезнут из UNYRI у ваших контактов. Копии, сохранённые вне UNYRI, удалить невозможно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення облікового запису незворотне. Ваш профіль, повідомлення, файли й особисті чати буде видалено із сервера. Після синхронізації особисті чати також зникнуть із UNYRI у ваших контактів. Копії, збережені поза UNYRI, видалити неможливо."
          }
        }
      }
    },
    "Open your authenticator and enter the current 6-digit UNYRI code below. This is not the long setup secret or your paper key. A saved recovery code is also accepted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your authenticator and enter the current 6-digit UNYRI code below. This is not the long setup secret or your paper key. A saved recovery code is also accepted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте аутентификатор и введите ниже текущий 6-значный код UNYRI. Это не длинный секрет настройки и не бумажный ключ. Также можно ввести сохранённый резервный код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте автентифікатор та введіть нижче поточний 6-значний код UNYRI. Це не довгий секрет налаштування й не паперовий ключ. Також можна ввести збережений резервний код."
          }
        }
      }
    },
