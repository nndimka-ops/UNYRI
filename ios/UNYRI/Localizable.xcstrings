    "This replaces only the unfinished setup key on this screen. Cross out the previous copy and write down the new one. Your server key is unchanged until sign-in succeeds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces only the unfinished setup key on this screen. Cross out the previous copy and write down the new one. Your server key is unchanged until sign-in succeeds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это заменит только ключ незавершённой настройки на этом экране. Зачеркните предыдущую запись и запишите новый ключ. На сервере ключ изменится только после успешного входа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить лише ключ незавершеного налаштування на цьому екрані. Закресліть попередній запис і запишіть новий ключ. На сервері ключ зміниться лише після успішного входу."
          }
        }
      }
    },
