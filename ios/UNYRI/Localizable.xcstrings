    "Your history is now on the new phone. The copy on this phone is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your history is now on the new phone. The copy on this phone is unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История уже на новом телефоне. На этом телефоне она тоже сохранилась."
          }
        },
        "uk": {
