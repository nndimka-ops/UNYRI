        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити облікові записи. Перевірте з’єднання."
          }
        }
      }
    },
    "New messages and calls in both directions will be blocked. Existing history stays.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages and calls in both directions will be blocked. Existing history stays."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые сообщения и звонки в обе стороны будут заблокированы. Существующая история останется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові повідомлення й дзвінки в обидва боки буде заблоковано. Наявна історія залишиться."
          }
        }
      }
    },
    "Your block will be removed. Messages and calls that were not delivered will not be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your block will be removed. Messages and calls that were not delivered will not be restored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша блокировка будет снята. Сообщения и звонки, которые не были доставлены, не восстановятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше блокування буде знято. Повідомлення й дзвінки, які не були доставлені, не відновляться."
          }
        }
      }
    },
    "If you already used this authenticator code to sign in, wait for the next code or use an unused recovery code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
