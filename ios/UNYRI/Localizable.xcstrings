    "The selected messages changed. Select them again and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected messages changed. Select them again and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные сообщения изменились. Выберите их снова и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані повідомлення змінилися. Виберіть їх знову та повторіть."
          }
        }
      }
    },
    "Unlock this iPhone, then retry. UNYRI has not changed your server or removed your history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this iPhone, then retry. UNYRI has not changed your server or removed your history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте iPhone и нажмите «Повторить». Адрес сервера, вход в аккаунт и переписка сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте iPhone і натисніть «Повторити». Адресу сервера, вхід в обліковий запис і листування збережено."
          }
        }
      }
    },
    "UNYRI could not safely identify the server for your saved account. Your session and history have not been removed. Choose a proven previous server below, or retry when storage is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UNYRI could not safely identify the server for your saved account. Your session and history have not been removed. Choose a proven previous server below, or retry when storage is available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить сервер сохранённого аккаунта. Вход и переписка сохранены. Выберите прежний сервер из списка или повторите попытку, когда хранилище станет доступно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити сервер збереженого облікового запису. Вхід і листування збережено. Виберіть попередній сервер зі списку або повторіть спробу, коли сховище стане доступним."
          }
        }
      }
    },
    "Update the UNYRI server to use direct file transfers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the UNYRI server to use direct file transfers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для прямой передачи файлов нужно обновить сервер UNYRI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для прямої передачі файлів потрібно оновити сервер UNYRI."
          }
        }
      }
    },
    "Could not continue the direct transfer. Keep UNYRI open on both devices and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not continue the direct transfer. Keep UNYRI open on both devices and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось продолжить передачу. Откройте UNYRI на обоих устройствах и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося продовжити передачу. Відкрийте UNYRI на обох пристроях і повторіть."
          }
        }
      }
    },
    "The recipient accepts the file first. Keep UNYRI open on both devices. The file is transferred directly and is not uploaded to the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient accepts the file first. Keep UNYRI open on both devices. The file is transferred directly and is not uploaded to the server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала получатель принимает файл. Держите UNYRI открытым на обоих устройствах. Файл передаётся напрямую и не загружается на сервер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку одержувач приймає файл. Тримайте UNYRI відкритим на обох пристроях. Файл передається напряму й не завантажується на сервер."
          }
        }
      }
    },
    "Update UNYRI on both devices and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update UNYRI on both devices and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите UNYRI на обоих устройствах и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть UNYRI на обох пристроях і повторіть."
          }
        }
      }
    },
    "Open UNYRI on both devices to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open UNYRI on both devices to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте UNYRI на обоих устройствах, чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте UNYRI на обох пристроях, щоб продовжити."
          }
        }
      }
    },
    "Waiting for a direct connection. Keep UNYRI open on both devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a direct connection. Keep UNYRI open on both devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём прямого соединения. Оставьте UNYRI открытым на обоих устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаємо прямого з’єднання. Залиште UNYRI відкритим на обох пристроях."
          }
        }
      }
    },
    "Unsupported administrator sign-in policy. Update UNYRI or use the Windows Admin Console.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported administrator sign-in policy. Update UNYRI or use the Windows Admin Console."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот способ входа не поддерживается. Обновите UNYRI или воспользуйтесь Windows-консолью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей спосіб входу не підтримується. Оновіть UNYRI або скористайтеся Windows-консоллю."
          }
        }
      }
    },
    "UNYRI closed unexpectedly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UNYRI closed unexpectedly"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UNYRI неожиданно закрылось"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UNYRI несподівано закрилося"
          }
        }
      }
    },
    "Start here. Save the recovery key outside UNYRI. Then you can create a copy of your messages and files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here. Save the recovery key outside UNYRI. Then you can create a copy of your messages and files."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните здесь. Сохраните ключ восстановления вне UNYRI. После этого можно создать копию сообщений и файлов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть тут. Збережіть ключ відновлення поза UNYRI. Після цього можна створити копію повідомлень і файлів."
          }
        }
      }
    },
    "The key is saved and uploads are allowed. Tap Create encrypted backup. Keep UNYRI open until it finishes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is saved and uploads are allowed. Tap Create encrypted backup. Keep UNYRI open until it finishes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ сохранён, загрузка разрешена. Нажмите «Создать зашифрованную копию» и оставьте UNYRI открытым до завершения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ збережено, завантаження дозволено. Натисніть «Створити зашифровану копію» та залиште UNYRI відкритим до завершення."
          }
        }
      }
    },
    "Your encrypted copy is stored on the server. Keep your recovery key outside UNYRI; signing in alone does not restore history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your encrypted copy is stored on the server. Keep your recovery key outside UNYRI; signing in alone does not restore history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованная копия хранится на сервере. Сохраните ключ вне UNYRI: одного входа в аккаунт для восстановления истории недостаточно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрована копія зберігається на сервері. Збережіть ключ поза UNYRI: самого входу в акаунт для відновлення історії недостатньо."
          }
        }
      }
    },
    "Unlock UNYRI with Face ID, Touch ID or your iPhone passcode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock UNYRI with Face ID, Touch ID or your iPhone passcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте UNYRI через Face ID, Touch ID или код iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте UNYRI через Face ID, Touch ID або код iPhone."
          }
        }
      }
    },
    "UNYRI is locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
