    "Connection interrupted. Waiting to continue history transfer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection interrupted. Waiting to continue history transfer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь прервалась. Ждём подключения, чтобы продолжить перенос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв’язок перервався. Чекаємо на підключення, щоб продовжити перенесення."
          }
        }
      }
    },
    "Mark the problem, continue using COCO briefly, then send a report. A small window before and after the mark is preserved. Collection pauses in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the problem, continue using UNYRI briefly, then send a report. A small window before and after the mark is preserved. Collection pauses in the background."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте проблему, немного продолжите пользоваться UNYRI и отправьте отчёт. Небольшой набор событий до и после отметки сохраняется отдельно. В фоне запись приостанавливается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте проблему, трохи продовжте користуватися UNYRI й надішліть звіт. Невеликий набір подій до та після позначки зберігається окремо. У фоні запис призупиняється."
          }
        }
      }
    },
    "Performance diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance diagnostics"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика производительности"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діагностика продуктивності"
          }
        }
      }
    },
    "Record performance diagnostics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record performance diagnostics"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать диагностику"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записувати діагностику"
          }
        }
      }
    },
    "Records timings, frame delays, memory, network state and technical stages while COCO is open. No messages, passwords, keys, typed text or screen recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records timings, frame delays, memory, network state and technical stages while UNYRI is open. No messages, passwords, keys, typed text or screen recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока UNYRI открыт, записываются задержки, кадры, память, состояние сети и этапы работы. Без сообщений, паролей, ключей, вводимого текста и записи экрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки UNYRI відкрито, записуються затримки, кадри, пам’ять, стан мережі та етапи роботи. Без повідомлень, паролів, ключів, введеного тексту та запису екрана."
          }
        }
      }
    },
    "Share live diagnostics with my server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share live diagnostics with my server"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять диагностику онлайн"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилати діагностику онлайн"
          }
        }
      }
    },
    "Optional. Sends small batches to your signed-in server. Only its owner can view them. Live batches expire within 24 hours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Sends small batches to your signed-in server. Only its owner can view them. Live batches expire within 24 hours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительно: небольшие пакеты отправляются на сервер вашего аккаунта. Их видит только владелец сервера. Онлайн-пакеты удаляются в течение 24 часов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатково: невеликі пакети надсилаються на сервер вашого облікового запису. Їх бачить лише власник сервера. Онлайн-пакети видаляються протягом 24 годин."
          }
        }
      }
    },
