    },
    "Verify, save key and restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify, save key and restore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить, сохранить ключ и восстановить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірити, зберегти ключ і відновити"
          }
        }
      }
    },
    "This replaces the saved key on this phone only after verifying the active backup. Existing messages and deletions are preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the saved key on this phone only after verifying the active backup. Existing messages and deletions are preserved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ на этом телефоне будет заменён только после проверки текущей копии. Существующие сообщения и удаления сохранятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ на цьому телефоні буде замінено лише після перевірки поточної копії. Наявні повідомлення та видалення збережуться."
          }
        }
      }
    },
    "The key will be verified and saved securely, then messages and files will be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key will be verified and saved securely, then messages and files will be restored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ будет проверен и безопасно сохранён, затем будут восстановлены сообщения и файлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ буде перевірено й безпечно збережено, потім буде відновлено повідомлення та файли."
          }
        }
      }
    },
    "End the call before scanning a history transfer code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the call before scanning a history transfer code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите звонок перед сканированием кода переноса истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть дзвінок перед скануванням коду перенесення історії."
          }
        }
      }
    },
    "Camera access is required to scan the code. Allow it in iOS Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to scan the code. Allow it in iOS Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования кода нужен доступ к камере. Разрешите его в настройках iOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканування коду потрібен доступ до камери. Дозвольте його в налаштуваннях iOS."
          }
        }
      }
    },
    "The camera could not scan this code. Close other camera apps and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not scan this code. Close other camera apps and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не смогла отсканировать код. Закройте другие приложения камеры и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не змогла відсканувати код. Закрийте інші застосунки камери й повторіть спробу."
          }
        }
      }
    },
    "History transfer expired or changed. Close it and create a new request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History transfer expired or changed. Close it and create a new request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок переноса истории истёк или запрос изменился. Закройте его и создайте новый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін перенесення історії минув або запит змінився. Закрийте його й створіть новий."
          }
        }
      }
    },
    "History transfer failed. Check the account, connection and expiry, then try again. Your saved key was not replaced unless you confirmed matching codes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History transfer failed. Check the account, connection and expiry, then try again. Your saved key was not replaced unless you confirmed matching codes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перенести историю. Проверьте аккаунт, подключение и срок запроса. Сохранённый ключ не заменяется без подтверждения совпадения кодов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перенести історію. Перевірте обліковий запис, з’єднання та термін запиту. Збережений ключ не замінюється без підтвердження збігу кодів."
          }
        }
      }
    },
    "Reconnecting. Keep both transfer screens open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting. Keep both transfer screens open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливаем соединение. Оставьте оба экрана переноса открытыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлюємо з’єднання. Залиште обидва екрани перенесення відкритими."
          }
        }
      }
    },
    "The verified key is saved on this phone. You can retry restoration even if transfer acknowledgement was interrupted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verified key is saved on this phone. You can retry restoration even if transfer acknowledgement was interrupted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенный ключ сохранён на этом телефоне. Можно повторить восстановление, даже если подтверждение передачи прервалось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірений ключ збережено на цьому телефоні. Можна повторити відновлення, навіть якщо підтвердження передачі перервалося."
          }
        }
      }
    },
    "Restore with saved key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore with saved key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить с сохранённым ключом"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити зі збереженим ключем"
          }
        }
      }
    },
    "Sign in to the same account and server on both phones. Prepare the encrypted copy on the old phone before creating the QR request on the new phone. Compare the codes before accepting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the same account and server on both phones. Prepare the encrypted copy on the old phone before creating the QR request on the new phone. Compare the codes before accepting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в один аккаунт на одном сервере на обоих телефонах. Подготовьте зашифрованную копию на старом телефоне до создания QR-запроса на новом. Сравните коды перед подтверждением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в один обліковий запис на одному сервері на обох телефонах. Підготуйте зашифровану копію на старому телефоні до створення QR-запиту на новому. Порівняйте коди перед підтвердженням."
          }
        }
      }
    },
    "Allow this new phone to receive the recovery key for the prepared encrypted copy? Compare the codes on both phones before accepting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this new phone to receive the recovery key for the prepared encrypted copy? Compare the codes on both phones before accepting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить новому телефону получить ключ восстановления подготовленной зашифрованной копии? Сравните коды на обоих телефонах перед подтверждением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити новому телефону отримати ключ відновлення підготовленої зашифрованої копії? Порівняйте коди на обох телефонах перед підтвердженням."
          }
        }
      }
    },
    "Approve encrypted transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve encrypted transfer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить зашифрованную передачу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити зашифровану передачу"
          }
        }
      }
    },
    "Includes history as of:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes history as of:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержит историю на:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Містить історію станом на:"
          }
        }
      }
    },
    "Create the QR request on the new phone now, then scan it here. Create a new copy to include later messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create the QR request on the new phone now, then scan it here. Create a new copy to include later messages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь создайте QR-запрос на новом телефоне и отсканируйте его здесь. Чтобы включить более новые сообщения, подготовьте новую копию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер створіть QR-запит на новому телефоні й відскануйте його тут. Щоб включити новіші повідомлення, підготуйте нову копію."
          }
        }
      }
    },
    "Prepare a new encrypted copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a new encrypted copy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовить новую зашифрованную копию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготувати нову зашифровану копію"
          }
        }
      }
    },
    "Prepare encrypted copy on old phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare encrypted copy on old phone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовить копию на старом телефоне"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготувати копію на старому телефоні"
          }
        }
      }
    },
    "The encrypted approval is ready. Retry sending the same approval if the connection was interrupted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted approval is ready. Retry sending the same approval if the connection was interrupted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованное подтверждение готово. Если соединение прервалось, повторите отправку того же подтверждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифроване підтвердження готове. Якщо з’єднання перервалося, повторіть надсилання того самого підтвердження."
          }
        }
      }
    },
    "Retry encrypted approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry encrypted approval"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить зашифрованное подтверждение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторити зашифроване підтвердження"
          }
        }
      }
    },
    "Previous history is not automatically restored. Use your history recovery key or transfer a prepared encrypted copy by QR from your old phone. You can also start messaging now. Keep your old phone until you have checked the restored history and files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous history is not automatically restored. Use your history recovery key or transfer a prepared encrypted copy by QR from your old phone. You can also start messaging now. Keep your old phone until you have checked the restored history and files."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая история не восстанавливается автоматически. Используйте ключ восстановления или перенесите подготовленную зашифрованную копию по QR-коду со старого телефона. Можно также начать переписку сейчас. Сохраните старый телефон, пока не проверите восстановленные сообщения и файлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередня історія не відновлюється автоматично. Скористайтеся ключем відновлення або перенесіть підготовлену зашифровану копію за QR-кодом зі старого телефону. Можна також почати листування зараз. Збережіть старий телефон, доки не перевірите відновлені повідомлення та файли."
          }
        }
      }
    },
    "Restore or transfer history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore or transfer history"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить или перенести историю"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити або перенести історію"
          }
        }
      }
    },
    "Prepare your history on this phone first, then scan the QR on the new phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your history on this phone first, then scan the QR on the new phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала подготовьте историю на этом телефоне, затем отсканируйте QR с нового телефона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку підготуйте історію на цьому телефоні, потім відскануйте QR з нового телефону."
          }
        }
      }
    },
    "Keep both phones signed in to the same account. Start with Send history on the old phone, then choose Receive history on the new one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both phones signed in to the same account. Start with Transfer from this phone on the old phone, then choose Receive on this phone on the new one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в один аккаунт на обоих телефонах. Сначала выберите «Перенести с этого телефона» на старом телефоне, затем «Получить на этот телефон» на новом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в один обліковий запис на обох телефонах. Спочатку виберіть «Перенести з цього телефона» на старому телефоні, потім «Отримати на цей телефон» на новому."
          }
        }
      }
    },
    "Open app settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open app settings"
          }
        },
        "ru": {
