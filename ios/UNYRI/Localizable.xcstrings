    "Theme appearance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme appearance"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема и оформление"
