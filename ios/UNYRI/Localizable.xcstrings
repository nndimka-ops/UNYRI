    "Create an encrypted copy of your messages and files. Restore it on another phone using your history recovery key. Copying runs while this screen is open." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an encrypted copy of your messages and files. Restore it on another phone using your history recovery key. Copying runs while this screen is open."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте зашифрованную копию сообщений и файлов. Восстановите её на другом телефоне с помощью ключа истории. Копирование работает, пока открыт этот экран."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть зашифровану копію повідомлень і файлів. Відновіть її на іншому телефоні за допомогою ключа історії. Копіювання працює, поки відкритий цей екран."
          }
        }
      }
    },
    "Create an encrypted copy of your messages and files. Restore it with your history recovery key. Keep this screen open for manual copying, or enable automatic daily backup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an encrypted copy of your messages and files. Restore it with your history recovery key. Keep this screen open for manual copying, or enable automatic daily backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте зашифрованную копию сообщений и файлов. Для восстановления нужен ключ истории. Оставьте этот экран открытым при ручном копировании или включите ежедневное автоматическое копирование."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть зашифровану копію повідомлень і файлів. Для відновлення потрібен ключ історії. Залиште цей екран відкритим під час ручного копіювання або увімкніть щоденне автоматичне копіювання."
          }
        }
      }
    },
