          }
        }
      }
    },
    "A security key is your device’s digital ID, not a password. It can change after reinstalling COCO or changing phones. Never send anyone your passwords or recovery keys.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A security key is your device’s digital ID, not a password. It can change after reinstalling UNYRI or changing phones. Never send anyone your passwords or recovery keys."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ безопасности — цифровое удостоверение устройства, а не пароль. Он может измениться после переустановки UNYRI или смены телефона. Пароли и ключи восстановления никому передавать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ безпеки — цифрове посвідчення пристрою, а не пароль. Він може змінитися після перевстановлення UNYRI або зміни телефона. Паролі та ключі відновлення нікому передавати не потрібно."
          }
        }
      }
    },
