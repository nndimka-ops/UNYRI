    },
    "Up to 10 items. Files up to 100 MB each; video originals up to 500 MB each. Photos are converted by UNYRI." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to 10 items. Files up to 100 MB each; video originals up to 500 MB each. Photos are converted by UNYRI."
