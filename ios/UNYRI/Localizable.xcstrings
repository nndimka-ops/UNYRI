    "Sends performance and call events, device model, OS and app version to your server; never messages, contacts, media or keys." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends performance and call events, device model, OS and app version to your server; never messages, contacts, media or keys."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ваш сервер отправляются события производительности и звонков, модель устройства, ОС и версия приложения; никогда — сообщения, контакты, медиа или ключи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ваш сервер надсилаються події продуктивності й дзвінків, модель пристрою, ОС і версія застосунку; ніколи — повідомлення, контакти, медіа чи ключі."
          }
        }
      }
    },
    "Sent" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано"
          }
        }
      }
    },
    "Sent as files without compression; they open in full quality." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются файлами без сжатия и открываются в полном качестве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилаються файлами без стиснення й відкриваються в повній якості."
          }
        }
      }
    },
    "Sent means accepted by the server. Delivered means received on a device. Read means a read receipt was received." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent means accepted by the server. Delivered means received on a device. Read means a read receipt was received."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено — принято сервером. Доставлено — получено устройством. Прочитано — получено подтверждение прочтения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано — прийнято сервером. Доставлено — отримано на пристрої. Прочитано — отримано підтвердження прочитання."
          }
        }
      }
    },
    "Sent when this phone has a connection and COCO can run. The system may delay background sending." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent when this phone has a connection and UNYRI can run. The system may delay background sending."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправится, когда на этом телефоне будет сеть и UNYRI сможет работать. Система может задержать фоновую отправку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде надіслано, коли цей телефон матиме з’єднання з мережею і UNYRI зможе працювати. Система може затримати фонове надсилання."
          }
        }
      }
    },
    "Sent when this phone has a connection and UNYRI can run. The system may delay background sending." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent when this phone has a connection and UNYRI can run. The system may delay background sending."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправится, когда на этом телефоне будет сеть и UNYRI сможет работать. Система может задержать фоновую отправку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде надіслано, коли цей телефон матиме з’єднання з мережею і UNYRI зможе працювати. Система може затримати фонове надсилання."
          }
        }
      }
    },
    "Separately saved copies and screenshots cannot be erased remotely." : {
      "localizations" : {
        "en" : {
