    "Send history · old phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer from this phone · old phone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить историю · старый телефон"
          }
        },
