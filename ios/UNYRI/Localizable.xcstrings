            "state": "translated",
            "value": "Порожній файл не можна передати напряму."
          }
        }
      }
    },
    "Could not read this file. Keep it selected and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read this file. Keep it selected and try again."
          }
        },
        "ru": {
