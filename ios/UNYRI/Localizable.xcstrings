            "state": "translated",
            "value": "Скопировать ключ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіювати ключ"
          }
        }
      }
    },
    "Last 8 characters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 8 characters"
          }
