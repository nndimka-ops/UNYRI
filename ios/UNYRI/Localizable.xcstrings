    "Save the code separately. It resets your password and signs out all phones. It does not restore encrypted history or replace your administrator key." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the code separately. It resets your password and signs out all phones. It does not restore encrypted history or replace your administrator key."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните код отдельно. Он сбрасывает пароль и завершает сеансы на всех телефонах. Он не восстанавливает зашифрованную историю и не заменяет ключ администратора."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть код окремо. Він скидає пароль і завершує сеанси на всіх телефонах. Він не відновлює зашифровану історію та не замінює ключ адміністратора."
          }
        }
      }
    },
    "Save the entire key in a password manager or write it down. Then enter its last 8 characters to confirm. This draft expires after 10 minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the entire key in a password manager or write it down. Then enter its last 8 characters to confirm. This draft expires after 10 minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните весь ключ в менеджере паролей или запишите. Затем введите последние 8 символов для подтверждения. Этот черновик действует 10 минут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть увесь ключ у менеджері паролів або запишіть. Потім введіть останні 8 символів для підтвердження. Ця чернетка діє 10 хвилин."
          }
        }
      }
    },
    "Save the recovery key outside COCO and confirm its last 8 characters. Then continue the transfer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the recovery key outside UNYRI and confirm its last 8 characters. Then continue the transfer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните ключ вне UNYRI и подтвердите его последние 8 символов. Затем продолжите перенос."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть ключ відновлення поза UNYRI та підтвердьте його останні 8 символів. Потім продовжте перенесення."
          }
        }
      }
    },
    "Save the recovery key outside UNYRI and confirm its last 8 characters. Then continue the transfer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the recovery key outside UNYRI and confirm its last 8 characters. Then continue the transfer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните ключ вне UNYRI и подтвердите его последние 8 символов. Затем продолжите перенос."
          }
        },
        "uk" : {
          "stringUnit" : {
