          }
        }
      }
    },
    "Open your authenticator and enter the current 6-digit COCO code below. This is not the long setup secret or your paper key. A saved recovery code is also accepted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your authenticator and enter the current 6-digit UNYRI code below. This is not the long setup secret or your paper key. A saved recovery code is also accepted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте аутентификатор и введите ниже текущий 6-значный код UNYRI. Это не длинный секрет настройки и не бумажный ключ. Также можно ввести сохранённый резервный код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте автентифікатор та введіть нижче поточний 6-значний код UNYRI. Це не довгий секрет налаштування й не паперовий ключ. Також можна ввести збережений резервний код."
          }
        }
      }
    },
    "The form was cleared after a long absence. Enter your saved paper key again. If authenticator setup was not finished, repeat step 1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form was cleared after a long absence. Enter your saved paper key again. If authenticator setup was not finished, repeat step 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма очищена после долгого отсутствия. Введите записанный бумажный ключ снова. Если настройка аутентификатора ещё не завершена, повторите шаг 1."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форму очищено після тривалої відсутності. Введіть записаний паперовий ключ знову. Якщо налаштування автентифікатора не завершено, повторіть крок 1."
          }
        }
      }
    },
    "Finish connecting the authenticator first.": {
