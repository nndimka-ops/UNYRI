    "This code has expired. Show a new code on the new phone and scan it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired. Show a new code on the new phone and scan it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время действия кода закончилось. Покажите новый код на новом телефоне и отсканируйте его ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час дії коду закінчився. Покажіть новий код на новому телефоні та відскануйте його ще раз."
          }
        }
      }
    },
    "Old phone is ready — show code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old phone is ready — show code"
          }
