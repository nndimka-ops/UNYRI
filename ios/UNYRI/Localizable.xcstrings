    "Confirm the device change, then close this screen to retry your selected message. Cancelling without confirmation will not send it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the device change, then close this screen to retry your selected message. Cancelling without confirmation will not send it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите смену устройства и закройте этот экран — выбранное сообщение отправится повторно. Если закрыть без подтверждения, отправка не начнётся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте зміну пристрою та закрийте цей екран — вибране повідомлення буде надіслано повторно. Якщо закрити без підтвердження, надсилання не почнеться."
          }
        }
      }
    },
    "Chats, messages, people": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, messages, people"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты, сообщения, люди"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чати, повідомлення, люди"
          }
        }
      }
    },
    "Search saved chats and messages offline. Find people on this server by username.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search saved chats and messages offline. Find people on this server by username."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите сохранённые чаты и сообщения без сети, а людей на этом сервере — по имени пользователя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте збережені чати й повідомлення без мережі, а людей на цьому сервері — за іменем користувача."
          }
        }
      }
    },
    "People on this server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People on this server"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
