            "state": "translated",
            "value": "How others see you. You can use a nickname and change it later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так вас видят собеседники. Можно использовать псевдоним и менять его позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так вас бачать співрозмовники. Можна використовувати псевдонім і змінювати його пізніше."
          }
        }
      }
    },
    "Unique on this server. Used for sign-in and search. 3–32 Latin letters, digits, underscores or dots.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unique on this server. Used for sign-in and search. 3–32 Latin letters, digits, underscores or dots."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникален на этом сервере. Для входа и поиска. 3–32 символа: латинские буквы, цифры, _ или точка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Унікальний на цьому сервері. Для входу й пошуку. 3–32 символи: латинські літери, цифри, _ або крапка."
          }
        }
      }
    },
    "The handle you chose when registering on this server, with or without @.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handle you chose when registering on this server, with or without @."
