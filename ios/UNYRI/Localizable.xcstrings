    "Old phone: it already has your messages. New phone: you want your messages to appear here. Keep both phones nearby and connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old phone: it already has your messages. New phone: you want your messages to appear here. Keep both phones nearby and connected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый телефон — на нём уже есть ваши сообщения. Новый телефон — вы хотите получить сообщения сюда. Держите оба телефона рядом и подключёнными к сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старий телефон — на ньому вже є ваші повідомлення. Новий телефон — ви хочете отримати повідомлення сюди. Тримайте обидва телефони поруч і підключеними до мережі."
          }
        }
      }
    },
    "Point the camera at the square on your NEW phone. It will be read automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the square on your NEW phone. It will be read automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на квадрат на НОВОМ телефоне. Он считается автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть камеру на квадрат на НОВОМУ телефоні. Він зчитається автоматично."
          }
        }
      }
    },
