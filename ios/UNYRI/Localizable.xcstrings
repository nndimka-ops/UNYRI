          }
        }
      }
    },
    "Backup and restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup and restore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирование и восстановление"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювання й відновлення"
          }
        }
      }
    },
    "Backup status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup status"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние копии"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан копії"
          }
        }
      }
    },
    "Before sending, prepare the old phone in History and backups and keep its recovery key saved outside COCO.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sending, prepare the old phone in History and backups and keep its recovery key saved outside UNYRI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед переносом откройте «История и резервные копии» на старом телефоне. Подготовьте историю и сохраните ключ восстановления вне UNYRI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед перенесенням відкрийте «Історія та резервні копії» на старому телефоні. Підготуйте історію та збережіть ключ відновлення поза UNYRI."
          }
        }
      }
    },
    "Encrypted history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted history"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованная история"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрована історія"
          }
        }
      }
    },
    "History tools are unavailable. Go back, then open this screen again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History tools are unavailable. Go back, then open this screen again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть историю. Вернитесь назад и откройте этот экран снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити історію. Поверніться назад і відкрийте цей екран знову."
          }
        }
      }
    },
    "On the new phone, choose Receive on this phone, then Old phone is ready — show code. On this phone, tap Scan QR on the new phone and scan that code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the new phone, choose Receive history · new phone, then Old phone is ready — show code. On this phone, tap Scan QR on the new phone and scan that code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На новом телефоне нажмите «Получить историю · новый телефон», затем «Старый телефон готов — показать код». На этом телефоне нажмите «Сканировать QR на новом телефоне» и отсканируйте код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На новому телефоні натисніть «Отримати історію · новий телефон», потім «Старий телефон готовий — показати код». На цьому телефоні натисніть «Сканувати QR на новому телефоні» та відскануйте код."
          }
        }
      }
    },
    "On the old phone, tap Scan QR on the new phone and point its camera at this square. Keep both screens open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the old phone, tap Scan QR on the new phone and point its camera at this square. Keep both screens open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На старом телефоне нажмите «Сканировать QR на новом телефоне» и наведите камеру на этот квадрат. Оставьте оба экрана открытыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На старому телефоні натисніть «Сканувати QR на новому телефоні» та наведіть камеру на цей квадрат. Залиште обидва екрани відкритими."
          }
        }
      }
    },
    "On your old phone, open Settings → History and backups → Transfer from this phone. Wait until its history is ready, then tap the button below. Keep both phones connected to the same account and server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your old phone, open Settings → History and backups → Transfer from this phone. Wait until its history is ready, then tap the button below. Keep both phones connected to the same account and server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На старом телефоне откройте «Настройки → История и резервные копии → Перенести с этого телефона». Дождитесь подготовки истории и нажмите кнопку ниже. На обоих телефонах должны быть один аккаунт и один сервер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На старому телефоні відкрийте «Налаштування → Історія та резервні копії → Перенести із цього телефону». Дочекайтеся підготовки історії та натисніть кнопку нижче. На обох телефонах мають бути один обліковий запис і один сервер."
          }
        }
      }
    },
