    "QR direction: the NEW phone shows it; the OLD phone scans it. This QR is not your recovery code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR direction: the NEW phone shows it; the OLD phone scans it. This QR is not your recovery code."
