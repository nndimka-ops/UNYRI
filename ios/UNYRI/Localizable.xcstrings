    "Only codes created on this screen can be copied or shared. The server cannot show older codes again." : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only codes created on this screen can be copied or shared. The server cannot show older codes again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать или отправить можно только коды, созданные на этом экране. Сервер не может снова показать старые коды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіювати або надіслати можна лише коди, створені на цьому екрані. Сервер не може знову показати старі коди."
          }
        }
      }
    },
