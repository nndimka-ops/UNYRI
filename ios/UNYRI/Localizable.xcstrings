        }
      }
    },
    "On the NEW phone, compare all four groups and tap The codes match. Keep this old phone's history until you have checked the result on the new phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the NEW phone, compare all four groups and tap The codes match. Keep this old phone's history until you have checked the result on the new phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На НОВОМ телефоне сравните все четыре группы и нажмите «Коды совпадают». Сохраните историю на старом телефоне, пока не проверите результат на новом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На НОВОМУ телефоні порівняйте всі чотири групи й натисніть «Коди збігаються». Збережіть історію на старому телефоні, доки не перевірите результат на новому."
          }
        }
      }
    },
    "Allow only the request you just scanned from your own NEW phone. Confirm with Face ID, Touch ID or this iPhone's passcode; then compare the codes on both screens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow only the request you just scanned from your own NEW phone. Confirm with Face ID, Touch ID or this iPhone's passcode; then compare the codes on both screens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешайте только запрос, который только что отсканировали со своего НОВОГО телефона. Подтвердите действие через Face ID, Touch ID или код-пароль этого iPhone, затем сравните коды на двух экранах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяйте лише запит, який щойно відсканували зі свого НОВОГО телефона. Підтвердьте дію через Face ID, Touch ID або код допуску цього iPhone, потім порівняйте коди на двох екранах."
          }
        }
      }
    },
    "Allow transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow transfer"
