    },
    "This device retired the old room key. A new room is being created. Ask others to leave the old room before continuing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device retired the old room key. A new room is being created. Ask others to leave the old room before continuing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство больше не использует старый ключ комнаты. Создаётся новая комната. Попросите остальных выйти из старой комнаты перед продолжением."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій більше не використовує старий ключ кімнати. Створюється нова кімната. Попросіть решту вийти зі старої кімнати перед продовженням."
          }
        }
      }
    },
    "This editor shows your saved message colors. They return in the colorful theme." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This editor shows your saved message colors. They return in the colorful theme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор показывает сохранённые цвета сообщений. В чате они вернутся в цветной теме."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор показує збережені кольори повідомлень. У чаті вони повернуться в кольоровій темі."
          }
        }
      }
    },
    "This file exceeds 100 MB, and direct transfer is unavailable in this conversation." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file exceeds 100 MB, and direct transfer is unavailable in this conversation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл больше 100 МБ, а отправка напрямую в этом чате недоступна."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл більший за 100 МБ, а надсилання напряму в цьому чаті недоступне."
          }
        }
      }
    },
    "This file exceeds the 64 GB direct-transfer limit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file exceeds the 64 GB direct-transfer limit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл превышает лимит прямой передачи — 64 ГБ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл перевищує обмеження прямого передавання — 64 ГБ."
          }
        }
      }
    },
    "This file is over 100 MB. It can go straight from this phone to the other phone, up to 64 GB, without cloud storage. The recipient has to accept it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл больше 100 МБ. Его можно отправить прямо с этого телефона на телефон получателя — до 64 ГБ, без облака. Получатель должен принять файл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей файл більший за 100 МБ. Його можна надіслати прямо з цього телефона на телефон отримувача — до 64 ГБ, без хмари. Отримувач має прийняти файл."
          }
        }
      }
    },
    "This invitation belongs to a different server. Sign in to that server explicitly before joining." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This invitation belongs to a different server. Sign in to that server explicitly before joining."
