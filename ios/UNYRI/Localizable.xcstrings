        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей обліковий запис уже додано на цьому пристрої."
          }
        }
      }
    },
    "This account is no longer available. Open UNYRI and share again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account is no longer available. Open UNYRI and share again."
