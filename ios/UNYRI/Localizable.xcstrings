            "state": "translated",
            "value": "Останні 8 символів"
          }
        }
      }
    },
    "I saved the key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I saved the key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я сохранил ключ"
          }
