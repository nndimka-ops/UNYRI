          }
        }
      }
    },
    "Save these recovery codes privately. Each code can be used once." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save these recovery codes privately. Each code can be used once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните резервные коды в безопасном месте. Каждый код одноразовый."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть резервні коди в безпечному місці. Кожен код одноразовий."
          }
        }
      }
    },
    "Save this key somewhere safe before continuing. Anyone with your private login and this key can reset your password. Keep them separate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save this key somewhere safe before continuing. Anyone with your private login and this key can reset your password. Keep them separate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед продолжением сохраните ключ в надёжном месте. Любой, у кого есть ваш личный логин и этот ключ, сможет сбросить пароль. Храните их отдельно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж продовжити, збережіть ключ у надійному місці. Будь-хто з вашим особистим логіном і цим ключем зможе скинути пароль. Зберігайте їх окремо."
          }
        }
      }
    },
