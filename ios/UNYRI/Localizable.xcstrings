    "Show this code on the NEW phone. On the OLD phone, tap Scan the new phone's code. Keep both screens open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show this code on the NEW phone. On the OLD phone, tap Scan the new phone's code. Keep both screens open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это код НОВОГО телефона. На СТАРОМ нажмите «Сканировать код нового телефона». Оставьте оба экрана открытыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це код НОВОГО телефона. На СТАРОМУ натисніть «Сканувати код нового телефона». Залиште обидва екрани відкритими."
          }
        }
      }
    },
    "The history on this OLD phone is ready. On the NEW phone choose Receive on this phone and show its code. Scan that code with this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history on this OLD phone is ready. On the NEW phone choose Receive on this phone and show its code. Scan that code with this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История на этом СТАРОМ телефоне готова. На НОВОМ выберите «Получить на этот телефон» и покажите код. Отсканируйте его ЭТИМ телефоном."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
