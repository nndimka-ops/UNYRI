            "value": "Я зберіг ключ"
          }
        }
      }
    },
    "Enter the recovery key saved when the backup was created. COCO will verify it without importing or changing your messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key saved when the backup was created. UNYRI will verify it without importing or changing your messages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ, сохранённый при создании копии. UNYRI проверит его, не импортируя и не изменяя сообщения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ключ, збережений під час створення копії. UNYRI перевірить його, не імпортуючи й не змінюючи повідомлення."
          }
        }
      }
    },
    "History recovery key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History recovery key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления истории"
          }
        },
        "uk": {
