    "If you already used this authenticator code to sign in, wait for the next code or use an unused recovery code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you already used this authenticator code to sign in, wait for the next code or use an unused recovery code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот код аутентификатора уже использовали при входе, дождитесь следующего или введите неиспользованный резервный код."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо цей код автентифікатора вже використали для входу, дочекайтеся наступного або введіть невикористаний резервний код."
          }
        }
      }
    },
    "If you do not open COCO with a server connection on any device for %d days, your account will be permanently deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you do not open UNYRI with a server connection on any device for %d days, your account will be permanently deleted."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в течение %d дней вы не откроете UNYRI с подключением к серверу ни на одном устройстве, ваш аккаунт будет удалён навсегда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо протягом %d днів ви не відкриєте UNYRI з підключенням до сервера на жодному пристрої, ваш акаунт буде видалено назавжди."
          }
        }
      }
    },
    "If you do not open UNYRI with a server connection on any device for %d days, your account will be permanently deleted." : {
