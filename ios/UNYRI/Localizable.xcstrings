      }
    },
    "The new key must open the current server backup. Only the key saved on this phone will change; the server backup is not rotated. A failed verification keeps the previous key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new key must open the current server backup. Only the key saved on this phone will change; the server backup is not rotated. A failed verification keeps the previous key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый ключ должен открывать текущую копию на сервере. Изменится только ключ на этом телефоне, сама копия останется прежней. При ошибке проверки старый ключ сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий ключ має відкривати поточну копію на сервері. Зміниться лише ключ на цьому телефоні, сама копія залишиться попередньою. Якщо перевірка не вдасться, старий ключ збережеться."
          }
        }
      }
    },
    "Transfer history by QR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer history by QR"
          }
        },
        "ru": {
