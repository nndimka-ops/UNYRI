    "Background alerts need internet and a server with notification support. Background alerts do not contain message text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background alerts need internet and a server with notification support. Background alerts do not contain message text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для фоновых уведомлений нужны интернет и сервер с поддержкой уведомлений. Текст сообщений в них не передаётся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для фонових сповіщень потрібні інтернет і сервер із підтримкою сповіщень. Текст повідомлень у них не передається."
          }
        }
      }
    },
    "iOS permission controls system alerts and message sounds. Calls keep their own system controls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS permission controls system alerts and message sounds. Calls keep their own system controls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение iOS управляет системными уведомлениями и звуком сообщений. У звонков остаются отдельные системные элементы управления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл iOS керує системними сповіщеннями та звуком повідомлень. Дзвінки зберігають окремі системні елементи керування."
          }
        }
      }
    },
