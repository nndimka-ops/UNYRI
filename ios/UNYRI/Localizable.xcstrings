    "Verify and save key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify and save key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить и сохранить ключ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірити й зберегти ключ"
          }
