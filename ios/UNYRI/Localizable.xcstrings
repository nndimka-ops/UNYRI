        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нік, обраний під час реєстрації на цьому сервері, з @ або без нього."
          }
        }
      }
    },
    "8–256 characters. Use a long password that you do not use elsewhere.": {
      "localizations": {
