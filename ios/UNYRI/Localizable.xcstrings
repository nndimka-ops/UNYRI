    "Anyone with this invitation can join and decrypt this room. Confirm the server and the invitation sender before joining." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with this invitation can join and decrypt this room. Confirm the server and the invitation sender before joining."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть приглашение, может войти и расшифровать аудио и видео. Перед входом проверьте сервер и отправителя приглашения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен, хто має запрошення, може увійти й розшифрувати аудіо та відео. Перед входом перевірте сервер і відправника запрошення."
          }
        }
      }
    },
    "Anyone with this invitation can join and decrypt this room. Share only with people you trust." : {
      "localizations" : {
        "en" : {
