          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно создать до трёх активных комнат. Каждая автоматически завершится через 24 часа."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
