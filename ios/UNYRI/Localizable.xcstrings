    "Operation cancelled. Your previous confirmed backup is kept. You can retry safely.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation cancelled. Your previous confirmed backup is kept. You can retry safely."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция отменена. Предыдущая подтверждённая копия сохранена. Можно повторить попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцію скасовано. Попередню підтверджену копію збережено. Можна повторити спробу."
          }
        }
      }
    },
    "History is incomplete on this phone. Finish synchronization or restore the existing backup before creating a new copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is incomplete on this phone. Finish synchronization or restore the existing backup before creating a new copy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История на этом телефоне неполная. Завершите синхронизацию или восстановите существующую копию перед созданием новой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія на цьому телефоні неповна. Завершіть синхронізацію або відновіть наявну копію перед створенням нової."
          }
        }
      }
    },
    "Messages changed during backup. Try creating the copy again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages changed during backup. Try creating the copy again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время копирования сообщения изменились. Создайте копию ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час копіювання повідомлення змінилися. Створіть копію ще раз."
          }
        }
      }
    },
    "Not enough free space to verify and restore the files. Free storage and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space to verify and restore the files. Free storage and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места для проверки и восстановления файлов. Освободите место и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо місця для перевірки та відновлення файлів. Звільніть місце й повторіть спробу."
          }
        }
      }
    },
    "Another history operation is running. Wait for it to finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another history operation is running. Wait for it to finish."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая операция с историей уже выполняется. Дождитесь её завершения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша операція з історією вже виконується. Дочекайтеся її завершення."
          }
        }
      }
    },
    "A file is unavailable. Keep your old phone and try again. The previous confirmed backup was not replaced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file is unavailable. Keep your old phone and try again. The previous confirmed backup was not replaced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл недоступен. Сохраните старый телефон и повторите попытку. Предыдущая подтверждённая копия не заменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл недоступний. Збережіть старий телефон і повторіть спробу. Попередню підтверджену копію не замінено."
          }
        }
      }
    },
    "A file failed verification. No unverified history was imported. Try downloading the copy again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file failed verification. No unverified history was imported. Try downloading the copy again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не прошёл проверку. Непроверенная история не импортирована. Повторите загрузку копии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не пройшов перевірку. Неперевірену історію не імпортовано. Повторіть завантаження копії."
          }
        }
      }
    },
    "Previous history is not automatically restored. Open an encrypted backup with your history recovery key, or start messaging now. Keep your old phone until you have checked the restored history and files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous history is not automatically restored. Open an encrypted backup with your history recovery key, or start messaging now. Keep your old phone until you have checked the restored history and files."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая история не восстанавливается автоматически. Откройте зашифрованную копию с ключом восстановления или начните переписку сейчас. Сохраните старый телефон, пока не проверите восстановленные сообщения и файлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередня історія не відновлюється автоматично. Відкрийте зашифровану копію з ключем відновлення або почніть листування зараз. Збережіть старий телефон, доки не перевірите відновлені повідомлення та файли."
          }
        }
      }
    },
    "Verified messages and files will be merged with this phone. Newer changes and deletions are preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified messages and files will be merged with this phone. Newer changes and deletions are preserved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенные сообщения и файлы будут объединены с историей на этом телефоне. Более новые изменения и удаления сохранятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірені повідомлення та файли буде об’єднано з історією на цьому телефоні. Новіші зміни та видалення збережуться."
          }
        }
      }
    },
    "Automatic daily backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic daily backup"
          }
        },
        "ru": {
