    "The original is unavailable. Choose the file again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original is unavailable. Choose the file again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал недоступен. Выберите файл заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал недоступний. Виберіть файл знову."
          }
        }
      }
    },
    "The file could not be verified. Ask the sender to send it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be verified. Ask the sender to send it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить файл. Попросите отправить его заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити файл. Попросіть надіслати його знову."
          }
        }
      }
    },
    "The recipient must restart the transfer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient must restart the transfer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получателю нужно начать передачу заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержувачу потрібно почати передачу знову."
          }
        }
      }
    },
    "The saved part differs. Restart the transfer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved part differs. Restart the transfer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённая часть отличается. Начните передачу заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережена частина відрізняється. Почніть передачу знову."
          }
        }
      }
    },
    "Free up space on this device, then retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space on this device, then retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место на этом устройстве и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звільніть місце на цьому пристрої та повторіть."
          }
        }
      }
    },
    "Paused during a call. It will continue afterwards.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused during a call. It will continue afterwards."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача приостановлена на время звонка и продолжится после него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передачу призупинено на час дзвінка. Вона продовжиться після нього."
          }
        }
      }
    },
    "Waiting for the other device to finish preparing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the other device to finish preparing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём завершения подготовки на другом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаємо завершення підготовки на іншому пристрої."
          }
        }
      }
    },
    "Could not verify the other device. Check the account and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the other device. Check the account and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить другое устройство. Проверьте аккаунт и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити інший пристрій. Перевірте обліковий запис і повторіть."
          }
        }
      }
    },
    "Allow access to the original file, then retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to the original file, then retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к оригиналу файла и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до оригіналу файлу та повторіть."
          }
        }
      }
    },
    "Update COCO on both devices and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update UNYRI on both devices and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите UNYRI на обоих устройствах и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть UNYRI на обох пристроях і повторіть."
          }
        }
      }
    },
    "Open COCO on both devices to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open UNYRI on both devices to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте UNYRI на обоих устройствах, чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте UNYRI на обох пристроях, щоб продовжити."
          }
        }
      }
    },
    "A direct connection is unavailable on this network. Try another network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A direct connection is unavailable on this network. Try another network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямое соединение в этой сети недоступно. Попробуйте другую сеть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пряме з’єднання в цій мережі недоступне. Спробуйте іншу мережу."
          }
        }
      }
    },
    "Waiting for a direct connection. Keep COCO open on both devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a direct connection. Keep UNYRI open on both devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём прямого соединения. Оставьте UNYRI открытым на обоих устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаємо прямого з’єднання. Залиште UNYRI відкритим на обох пристроях."
          }
        }
      }
    },
    "Original files, without compression": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original files, without compression"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналы без сжатия"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінали без стиснення"
          }
        }
      }
    },
    "The recipient accepts the file first. Keep COCO open on both devices. The file is transferred directly and is not uploaded to the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient accepts the file first. Keep UNYRI open on both devices. The file is transferred directly and is not uploaded to the server."
          }
        },
        "ru": {
          "stringUnit": {
