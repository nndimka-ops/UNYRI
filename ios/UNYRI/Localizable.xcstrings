          "stringUnit": {
            "state": "translated",
            "value": "Это камера СТАРОГО телефона. Наведите её на QR, показанный на НОВОМ телефоне: он распознается автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це камера СТАРОГО телефона. Наведіть її на QR, показаний на НОВОМУ телефоні: він розпізнається автоматично."
          }
        }
      }
    },
    "Delete batch": {
      "extractionState": "manual",
