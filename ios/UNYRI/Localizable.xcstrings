{
  "sourceLanguage": "en",
  "strings": {
    "Selected %d items. You can add %d more (maximum %d attachments). Nothing was added. Choose fewer items and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected %d items. You can add %d more (maximum %d attachments). Nothing was added. Choose fewer items and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано элементов: %d. Можно добавить ещё %d (не более %d вложений). Ничего не добавлено. Выберите меньше элементов и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано елементів: %d. Можна додати ще %d (щонайбільше %d вкладень). Нічого не додано. Виберіть менше елементів і спробуйте ще раз."
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створити"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва"
          }
        }
      }
    },
    "Could not open this file. Check that it is available on this device, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open this file. Check that it is available on this device, then try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть файл. Проверь его доступность на этом устройстве и попробуй ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити файл. Перевір його доступність на цьому пристрої та спробуй ще раз."
          }
        }
      }
    },
    "File not copied with history. Ask the sender to send it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File not copied with history. Ask the sender to send it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не перенесён с историей. Попроси отправить его ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не перенесено з історією. Попроси надіслати його ще раз."
          }
        }
      }
    },
    "Waiting for transfer information…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for transfer information…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание данных передачи…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування даних передачі…"
          }
        }
      }
    },
    "Direct files can be sent only to another person. Files up to 100 MB can still be sent normally.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct files can be sent only to another person. Files up to 100 MB can still be sent normally."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую можно отправлять файлы только другому человеку. Файлы до 100 МБ можно отправить обычным способом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряму можна надсилати файли лише іншій людині. Файли до 100 МБ можна надіслати звичайним способом."
          }
        }
      }
    },
    "Unblock this conversation before sending a direct file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock this conversation before sending a direct file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте собеседника перед отправкой файла напрямую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте співрозмовника перед надсиланням файлу напряму."
          }
        }
      }
    },
    "Another file is being prepared. Wait or cancel it first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another file is being prepared. Wait or cancel it first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготавливается другой файл. Дождитесь завершения или отмените подготовку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готується інший файл. Дочекайтеся завершення або скасуйте підготовку."
          }
        }
      }
    },
    "The account changed. Open the conversation again and try sending the file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account changed. Open the conversation again and try sending the file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт изменился. Откройте чат заново и повторите отправку файла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис змінився. Відкрийте чат знову й повторіть надсилання файлу."
          }
        }
      }
    },
    "This file exceeds 100 MB, and direct transfer is unavailable in this conversation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file exceeds 100 MB, and direct transfer is unavailable in this conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл больше 100 МБ, а отправка напрямую в этом чате недоступна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл більший за 100 МБ, а надсилання напряму в цьому чаті недоступне."
          }
        }
      }
    },
    "Call video": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call video"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео звонка"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео дзвінка"
          }
        }
      }
    },
    "Show or hide call controls": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or hide call controls"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать или скрыть элементы управления звонком"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати або приховати елементи керування дзвінком"
          }
        }
      }
    },
    "Fit or fill remote video": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit or fill remote video"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать видео собеседника целиком или заполнить экран"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати відео співрозмовника повністю або заповнити екран"
          }
        }
      }
    },
    "Drag to move. Pinch to resize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move. Pinch to resize"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для перемещения. Сведите или разведите пальцы для изменения размера"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть для переміщення. Зведіть або розведіть пальці для зміни розміру"
          }
        }
      }
    },
