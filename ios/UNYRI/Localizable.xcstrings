    },
    "Set up administrator access once. Afterward, use the same paper key each time you sign in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up administrator access once. Afterward, use the same paper key each time you sign in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте доступ один раз. В дальнейшем для входа используйте тот же бумажный ключ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте доступ один раз. Надалі для входу використовуйте той самий паперовий ключ."
          }
        }
      }
    },
    "Enter your account password, saved paper key and a current authenticator code. Do not generate a new paper key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your account password, saved paper key and a current authenticator code. Do not generate a new paper key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль аккаунта, сохранённый бумажный ключ и текущий код аутентификатора. Новый ключ создавать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть пароль акаунта, збережений паперовий ключ і поточний код автентифікатора. Новий ключ створювати не потрібно."
          }
        }
      }
    },
    "1 · Connect an authenticator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Connect an authenticator"
          }
        },
