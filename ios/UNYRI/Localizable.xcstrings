    },
    "Opening COCO with a server connection on any device resets the inactivity period. Background notifications and token refresh do not reset it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening UNYRI with a server connection on any device resets the inactivity period. Background notifications and token refresh do not reset it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытие UNYRI с подключением к серверу на любом устройстве начинает отсчёт заново. Фоновые уведомления и обновление токена не сбрасывают срок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриття UNYRI з підключенням до сервера на будь-якому пристрої починає відлік заново. Фонові сповіщення й оновлення токена не скидають строк."
          }
        }
      }
    },
    "Account auto-delete saved.": {
      "localizations": {
