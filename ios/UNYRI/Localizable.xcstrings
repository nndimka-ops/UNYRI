    },
    "This list is checked against the server code and is updated whenever the server changes what it keeps." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот список сверен с кодом сервера и обновляется, когда меняется то, что сервер хранит."
