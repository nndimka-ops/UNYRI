          }
        }
      }
    },
    "Installation protection requires HTTPS. This development connection uses legacy sign-in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation protection requires HTTPS. This development connection uses legacy sign-in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для защиты установки нужен HTTPS. В этом тестовом подключении используется обычный вход без защиты установки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для захисту інсталяції потрібен HTTPS. У цьому тестовому з’єднанні використовується звичайний вхід без захисту інсталяції."
          }
        }
      }
    },
    "This server does not support installation protection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not support installation protection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не поддерживает защиту от обхода блокировки на том же устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер не підтримує захист від обходу блокування на тому самому пристрої."
          }
        }
      }
