    "Keep this key privately. It is never sent to the server. Losing every copy prevents signing in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this key privately. It is never sent to the server. Losing every copy prevents signing in."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните ключ в секрете. Он не передаётся серверу. При потере всех копий войти не получится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте ключ у таємниці. Він не передається серверу. Якщо втратити всі копії, увійти не вдасться."
          }
        }
      }
    },
    "Keep this screen open until this step finishes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте экран, пока этот шаг не завершится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривайте екран, доки цей крок не завершиться."
          }
        }
      }
    },
    "Keep this screen open while messages and files arrive. If interrupted, continue here — you do not need to scan again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this screen open while messages and files arrive. If interrupted, continue here — you do not need to scan again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте экран, пока загружаются сообщения и файлы. Если загрузка прервётся, продолжите здесь — сканировать заново не нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривайте екран, поки завантажуються повідомлення та файли. Якщо завантаження перерветься, продовжте тут — сканувати знову не потрібно."
          }
        }
      }
    },
    "Keep this screen open. Do not create another request while this step is running." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this screen open. Do not create another request while this step is running."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте этот экран открытым. Пока идёт этот этап, не создавайте ещё один запрос."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залиште цей екран відкритим. Поки триває цей етап, не створюйте ще один запит."
          }
        }
      }
    },
    "Keep transfer" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить передачу"
          }
        },
