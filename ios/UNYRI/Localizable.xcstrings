    "Username must be 3-32 characters and may only contain letters, digits, '_' and '.'.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя должно содержать 3–32 символа: латинские буквы, цифры, «_» и «.»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
