      }
    },
    "Deleted account" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deleted account" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалённый аккаунт" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Видалений акаунт" } }
      }
    },
    "Erases the account and its messages on the server and on phones when they connect." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Erases the account and its messages on the server and on phones when they connect." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удаляет аккаунт и его сообщения на сервере и на телефонах при подключении." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Видаляє акаунт і його повідомлення на сервері та на телефонах під час підключення." } }
      }
    },
    "Enter the account number to confirm" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the account number to confirm" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Введите номер аккаунта для подтверждения" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Введіть номер акаунта для підтвердження" } }
      }
    },
    "Reason for deletion" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reason for deletion" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Причина удаления" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Причина видалення" } }
      }
    },
    "This call needs a relay (TURN), but this server has none. A safe connection is unavailable." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This call needs a relay (TURN), but this server has none. A safe connection is unavailable." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для звонка нужен сервер-посредник (TURN), но здесь его нет. Без прямого соединения звонок невозможен." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Для дзвінка потрібен сервер-посередник (TURN), але тут його немає. Без прямого з’єднання дзвінок неможливий." } }
      }
    },
    "The other person allows server-only connections, but the relay server is unavailable." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The other person allows server-only connections, but the relay server is unavailable." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У собеседника включены соединения только через сервер, а сервер-посредник недоступен." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "У співрозмовника ввімкнені з’єднання лише через сервер, а сервер-посередник недоступний." } }
      }
    },
    "A relay is required by your peer-to-peer setting, but this server has no relay configured. The transfer cannot connect safely." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A relay is required by your peer-to-peer setting, but this server has no relay configured. The transfer cannot connect safely." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши настройки прямых соединений требуют ретранслятор, но на этом сервере он не настроен. Безопасно подключить передачу невозможно." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваші налаштування прямих з'єднань вимагають ретранслятор, але на цьому сервері його не налаштовано. Безпечно підключити передачу неможливо." } }
      }
    },
    "Directly only with saved contacts. Everyone else via the server." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Directly only with saved contacts. Everyone else via the server." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напрямую только с сохранёнными контактами. С остальными — через сервер." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Напряму лише зі збереженими контактами. З рештою — через сервер." } }
      }
    },
    "A direct connection is usually faster, but the other person's device can see your IP address. Via the server, only the server's address is visible. Applies from the next call. The same setting applies to file transfers." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A direct connection is usually faster, but the other person's device can see your IP address. Via the server, only the server's address is visible. Applies from the next call. The same setting applies to file transfers." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прямое соединение обычно быстрее, но устройство собеседника видит ваш IP-адрес. Через сервер виден только адрес сервера. Изменение применяется со следующего звонка. Та же настройка действует для передачи файлов." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Пряме з'єднання зазвичай швидше, але пристрій співрозмовника бачить вашу IP-адресу. Через сервер видно лише адресу сервера. Зміна застосовується з наступного дзвінка. Те саме налаштування діє для передавання файлів." } }
      }
    },
