    "Double-tap a message to react. In the photo viewer, double-tap still zooms.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap a message to react. In the photo viewer, double-tap still zooms."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите на сообщение, чтобы поставить реакцию. В просмотрщике фото двойное нажатие по-прежнему увеличивает изображение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі натисніть на повідомлення, щоб поставити реакцію. У переглядачі фото подвійне натискання, як і раніше, збільшує зображення."
          }
        }
      }
    },
    "Preparing media…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing media…"
          }
        },
        "ru": {
