            "state": "translated",
            "value": "1 · Підключіть автентифікатор"
          }
        }
      }
    },
    "2 · Save your paper key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Save your paper key"
          }
        },
        "ru": {
