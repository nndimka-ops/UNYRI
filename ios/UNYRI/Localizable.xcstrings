      }
    },
    "Allow this new phone to receive your history recovery key through an encrypted handoff? A fresh backup will be created first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this new phone to receive your history recovery key through an encrypted handoff? A fresh backup will be created first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить новому телефону получить ключ восстановления истории через зашифрованную передачу? Сначала будет создана свежая копия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити новому телефону отримати ключ відновлення історії через зашифровану передачу? Спочатку буде створено свіжу копію."
          }
        }
      }
    },
    "Approve and create fresh backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve and create fresh backup"
          }
        },
        "ru": {
