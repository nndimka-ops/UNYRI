          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви підтвердили збіг кодів перевірки. У разі зміни коду порівняйте його знову."
          }
        }
      }
    },
    "You enter with camera and microphone off. An online participant sends the key encrypted for this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You enter with camera and microphone off. An online participant sends the key encrypted for this device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы войдёте с выключенными камерой и микрофоном. Участник в сети передаст ключ, зашифрованный только для этого устройства."
          }
        },
        "uk" : {
