      }
    },
    "When off, others do not see new read receipts. Your own unread count still updates. Previous receipts remain visible." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, others do not see new read receipts. Your own unread count still updates. Previous receipts remain visible."
