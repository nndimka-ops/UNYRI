          }
        }
      }
    },
    "This original is over 100 MB. Turn on Send directly and send again. Your selected items are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This original is over 100 MB. Turn on Send directly and send again. Your selected items are kept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал больше 100 МБ. Включите «Отправить напрямую» и повторите отправку. Выбранные вложения сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал більший за 100 МБ. Увімкніть «Надіслати напряму» та повторіть надсилання. Вибрані вкладення збережено."
          }
        }
      }
    },
    "Could not prepare the file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить файл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підготувати файл."
          }
        }
      }
    },
    "Send photos, videos or files after the recipient accepts. Offline offers wait in the chat. You can pause, continue or cancel in Transfers. The file itself is not kept in cloud storage; encrypted offers and small previews still use the server. On iPhone, transfer may pause while UNYRI is in the background. Quality is selected separately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos, videos or files after the recipient accepts. Offline offers wait in the chat. You can pause, continue or cancel in Transfers. The file itself is not kept in cloud storage; encrypted offers and small previews still use the server. On iPhone, transfer may pause while UNYRI is in the background. Quality is selected separately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте фото, видео и файлы после согласия получателя. Если он не в сети, предложение останется в чате. Передачу можно приостановить, продолжить или отменить в разделе «Передачи». Сам файл не хранится в облаке; зашифрованные предложения и небольшие превью проходят через сервер. На iPhone передача может приостановиться после сворачивания UNYRI. Качество выбирается отдельно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилайте фото, відео й файли після згоди одержувача. Якщо він не в мережі, пропозиція залишиться в чаті. Передавання можна призупинити, продовжити або скасувати в розділі «Передавання». Сам файл не зберігається в хмарі; зашифровані пропозиції та невеликі прев’ю проходять через сервер. На iPhone передавання може призупинитися після згортання UNYRI. Якість вибирається окремо."
          }
        }
      }
    },
    "Direct transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct transfer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая передача"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пряме передавання"
          }
        }
      }
    }
  },
  "version": "1.0"
