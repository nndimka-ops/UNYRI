    "Manage blocked accounts here, even after deleting a chat. Unblocking does not restore missed messages or calls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage blocked accounts here, even after deleting a chat. Unblocking does not restore missed messages or calls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь остаются заблокированные аккаунты, даже если чат удалён. После разблокировки пропущенные сообщения и звонки не восстанавливаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут залишаються заблоковані облікові записи, навіть якщо чат видалено. Після розблокування пропущені повідомлення й дзвінки не відновлюються."
          }
        }
      }
    },
    "Choose an account to block. Opening this list does not create a chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an account to block. Opening this list does not create a chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, кого заблокировать. Просмотр списка не создаёт переписку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, кого заблокувати. Перегляд списку не створює листування."
          }
        }
      }
    },
    "The change was not confirmed. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was not confirmed. Check your connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение не подтверждено. Проверьте соединение и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміну не підтверджено. Перевірте з’єднання й повторіть."
          }
        }
      }
    },
    "Could not load accounts. Check your connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load accounts. Check your connection."
