      }
    },
    "The operation could not be completed. Check your connection and recovery key, then refresh. Existing keys are never replaced automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not be completed. Check your connection and recovery key, then refresh. Existing keys are never replaced automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить действие. Проверьте соединение и ключ восстановления, затем обновите экран. Существующие ключи автоматически не заменяются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити дію. Перевірте з’єднання та ключ відновлення, потім оновіть екран. Наявні ключі автоматично не замінюються."
          }
        }
      }
    },
    "Use the complete key beginning with COCO-H1-, including all eight groups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the complete key beginning with COCO-H1-, including all eight groups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен полный ключ, начинающийся с COCO-H1-, со всеми восемью группами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен повний ключ, що починається з COCO-H1-, з усіма вісьмома групами."
          }
        }
      }
    },
    "The unsaved key draft expired. Prepare a new key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unsaved key draft expired. Prepare a new key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время несохранённого черновика истекло. Подготовьте новый ключ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін незбереженої чернетки минув. Підготуйте новий ключ."
          }
        }
      }
    },
    "Disable future backup uploads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable future backup uploads"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить будущую загрузку копий"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути майбутнє завантаження копій"
          }
        }
      }
    },
    "Backup uploads disabled. Existing copies are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup uploads disabled. Existing copies are kept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка копий отключена. Существующие копии сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження копій вимкнено. Наявні копії збережено."
          }
        }
      }
    },
    "Delete server backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete server backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить копию с сервера"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити копію із сервера"
          }
        }
      }
    },
    "The server copy will be permanently deleted and future uploads disabled. Messages on your phones and the recovery key will remain. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server copy will be permanently deleted and future uploads disabled. Messages on your phones and the recovery key will remain. This cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия на сервере будет безвозвратно удалена, а будущие загрузки отключены. Сообщения на телефонах и ключ восстановления сохранятся. Отменить это действие нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію на сервері буде безповоротно видалено, а майбутні завантаження вимкнено. Повідомлення на телефонах і ключ відновлення залишаться. Скасувати цю дію неможливо."
          }
        }
      }
    },
    "Allow future backup uploads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow future backup uploads"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить будущую загрузку копий"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити майбутнє завантаження копій"
          }
        }
      }
    },
    "This key cannot open the backup. Check that you entered the history recovery key for this account and server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key cannot open the backup. Check that you entered the history recovery key for this account and server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ не открывает копию. Убедитесь, что это ключ восстановления истории именно для этого аккаунта и сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ключ не відкриває копію. Переконайтеся, що це ключ відновлення історії саме для цього облікового запису й сервера."
          }
        }
      }
    },
    "This server does not support history backups yet. Ask its owner to update the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not support history backups yet. Ask its owner to update the server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер пока не поддерживает резервные копии истории. Попросите его владельца обновить сервер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер поки не підтримує резервні копії історії. Попросіть його власника оновити сервер."
          }
        }
      }
    },
    "Last confirmed copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last confirmed copy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя подтверждённая копия"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання підтверджена копія"
          }
        }
      }
    },
    "An unfinished upload exists. It is not a usable backup. Delete it before preparing a new key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unfinished upload exists. It is not a usable backup. Delete it before preparing a new key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть незавершённая загрузка. Восстановление из неё невозможно. Удалите её перед подготовкой нового ключа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є незавершене завантаження. Відновлення з нього неможливе. Видаліть його перед підготовкою нового ключа."
          }
        }
      }
    },
    "Create an encrypted copy of your messages and files. Restore it on another phone using your history recovery key. Copying runs while this screen is open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an encrypted copy of your messages and files. Restore it on another phone using your history recovery key. Copying runs while this screen is open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте зашифрованную копию сообщений и файлов. Восстановите её на другом телефоне с помощью ключа истории. Копирование работает, пока открыт этот экран."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть зашифровану копію повідомлень і файлів. Відновіть її на іншому телефоні за допомогою ключа історії. Копіювання працює, поки відкритий цей екран."
          }
        }
      }
    },
    "Create encrypted backup": {
