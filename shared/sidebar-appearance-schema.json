  "collections": {
    "itemOrder": "all known IDs exactly once; keep first valid occurrence then append missing defaults",
    "hiddenItems": "known IDs excluding chats/settings",
    "itemColors": "known ID to #RRGGBB"
  },
  "readPolicy": "unknown fields ignored; malformed scalar fields use saved defaults; unsupported version/oversize uses all defaults",
