{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ClientPutsIntoCocoBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::__COCO_BUCKET__/*"]
    },
    {
      "Sid": "DenyCopySourcesIncludingOtherBucketsAndVersions",
      "Effect": "Deny",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::*/*"]
    }
  ]
}
