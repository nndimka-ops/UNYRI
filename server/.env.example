SERVER_HOST=0.0.0.0
# Local development only. Public deployments must set COCO_ENV=production.
# Unset: debug binaries use development; release binaries use production.
COCO_ENV=development
SERVER_PORT=8080
DATABASE_URL=postgres://messenger:messenger@127.0.0.1:5432/messenger
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=info,messenger_server=debug
JWT_SECRET=change-me-to-a-long-random-value-in-production
JWT_ISSUER=messenger-server
JWT_AUDIENCE=messenger-clients
# Comma-separated direct peers allowed to supply X-Forwarded-For. Leave empty
# when clients connect directly; set only the actual TLS proxy addresses.
# Local Caddy example: TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
TEST_DATABASE_URL=postgres://messenger:messenger@127.0.0.1:5432/messenger_test
TEST_REDIS_URL=redis://127.0.0.1:6379/1
S3_ENDPOINT_URL=http://localhost:9000
# Host-reachable MinIO endpoint handed to Android inside presigned URLs.
# - Emulator: http://10.0.2.2:9000
# - Physical phones on the same LAN: http://<PC-LAN-IP>:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=messenger-attachments
S3_ACCESS_KEY_ID=messenger_minio
S3_SECRET_ACCESS_KEY=messenger_minio_secret
# Separate write-only IAM principal for client upload URLs. Never reuse the
# reader/root identity. Allow s3:PutObject on this bucket; explicitly deny
# s3:GetObject and s3:GetObjectVersion on arn:aws:s3:::*/* to deny CopyObject
# and UploadPartCopy. See storage-client-uploads-policy.template.json; replace
# __COCO_BUCKET__ with S3_BUCKET. The privileged reader above stays server-side.
S3_UPLOAD_ACCESS_KEY_ID=
S3_UPLOAD_SECRET_ACCESS_KEY=
# Absolute body timeout, enforced by the ONLY publicly reachable upload ingress.
# E.g. 1860 for Caddy hard read_body 30m plus S3 response_header_timeout 1m.
# See storage-ingress.caddy, storage-proxy-transport.caddy and the legacy
# root PUT revocation in storage-root-put-guard.caddy.
# Keep MinIO port 9000 private. This is NOT an idle timeout. Zero/missing
# disables client uploads; do not claim a bound the proxy does not enforce.
S3_MAX_UPLOAD_DURATION_SECONDS=0
# Set only after the proxy rejects old privileged PUT URLs and all old HTTP
# connections have been terminated/drained. Unix UTC seconds; the reconciler
# waits another 60 seconds. New empty buckets do not need this checkpoint.
S3_LEGACY_PUT_REVOKED_AT=0
# Quota accounting requires an unversioned bucket. Enabled AND Suspended
# versioning are rejected; never enable it on the live COCO bucket.
S3_PRESIGN_TTL_SECONDS=600

# STUN/TURN for 1:1 WebRTC calls. Use the host-reachable LAN IP so physical
# phones work without any external STUN server (same-LAN host candidates
# usually connect directly; coturn is the relay fallback). 10.0.2.2 only
# works on the Android emulator.
TURN_STUN_URLS=stun:127.0.0.1:3478
TURN_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_SHARED_SECRET=dev_turn_shared_secret_change_me
TURN_CREDENTIAL_TTL_SECONDS=3600

# FCM push (Этап K) - OPTIONAL. Leave unset to run the server without Firebase.
# FCM_PROJECT_ID=<your-firebase-project-id>
# FCM_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# (fallback: the standard GOOGLE_APPLICATION_CREDENTIALS env var is also honored)

# Optional E2EE group conferences. All credentials absent => feature disabled.
# Public SFU signaling MUST pass the backend authorize-sfu gateway, with no
# alternate public access to port 7880 or Twirp. SFU room.auto_create=false.
# CONFERENCE_LIVEKIT_URL=wss://meet.example.com
# CONFERENCE_LIVEKIT_API_URL=http://127.0.0.1:7880
# CONFERENCE_LIVEKIT_API_KEY=<operator-generated-api-key>
# CONFERENCE_LIVEKIT_API_SECRET=<operator-generated-at-least-32-byte-secret>
# Set these acknowledgements only after verifying both infrastructure controls.
# CONFERENCE_LIVEKIT_AUTOCREATE_DISABLED=true
# CONFERENCE_GATEWAY_REQUIRED=true


# Native APNs (optional, independent of FCM; provider .p8 is never committed).
# TestFlight/App Store use production. Topic/key authorization must match Apple.
# APNS_ALLOWED_ENVIRONMENTS=production
# APNS_ALLOWED_TOPICS=com.example.app,com.example.app.voip
# APNS_PRODUCTION_TEAM_ID=<10-character-Apple-team-id>
# APNS_PRODUCTION_KEY_ID=<10-character-APNs-key-id>
# APNS_PRODUCTION_KEY_FILE=/run/secrets/apns-production.p8
# Optional isolated development credentials (never silently used for production):
# APNS_SANDBOX_TEAM_ID=<10-character-Apple-team-id>
# APNS_SANDBOX_KEY_ID=<10-character-APNs-key-id>
# APNS_SANDBOX_KEY_FILE=/run/secrets/apns-sandbox.p8
